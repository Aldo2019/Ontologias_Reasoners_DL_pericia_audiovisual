#!/usr/bin/env python3
"""
populate_abox.py

Gera, de forma determinística, a ABox em Turtle (OWL 2 DL) a partir dos
metadados brutos extraídos via ffprobe (ver scripts/extract_metadata.sh),
populando o esquema conceitual descrito na Seção 6 do artigo.

Nenhuma comparação de valores é feita pela ontologia: toda a lógica de
comparação (frame rate nominal vs. calculada; identificação de contêiner
entre segmentos da mesma câmera) é realizada aqui, fora do raciocinador,
conforme a divisão de responsabilidades descrita na Seção 6.2. Os fatos
resultantes (correlacionaComDivergencia / correlacionaComEquivalencia /
temGrauDeConfianca) são então asseridos como triplas RDF.

Uso:
    python3 populate_abox.py data/*.json > ontology/abox_gerada.ttl

Entrada esperada: arquivos JSON de saída do ffprobe (um por fonte/segmento),
com nomes já anonimizados (ex.: Camera_9_1.json), sem qualquer identificador
de caso, operador ou instituição.
"""

import json
import os
import re
import sys
from itertools import combinations


def parse_rate(s):
    """Converte uma taxa 'num/den' (formato ffprobe) em float, ou None."""
    if not s:
        return None
    try:
        num, den = s.split("/")
        num, den = float(num), float(den)
        return num / den if den != 0 else None
    except Exception:
        return None


def group_of(name):
    """Agrupa segmentos da mesma câmera: 'Camera_9_1' -> 'Camera_9'."""
    m = re.match(r"(Camera_\d+)(?:_(\d+))?$", name)
    return m.group(1) if m else name


def load_corpus(paths):
    data = {}
    for p in paths:
        d = json.load(open(p))
        name = os.path.splitext(os.path.basename(p))[0]
        fmt = d["format"]
        video = next((s for s in d["streams"] if s.get("codec_type") == "video"), None)
        data[name] = {
            "group": group_of(name),
            "format_name": fmt.get("format_name"),
            "probe_score": fmt.get("probe_score"),
            "r_frame_rate": video.get("r_frame_rate") if video else None,
            "avg_frame_rate": video.get("avg_frame_rate") if video else None,
        }
    return data


def emit(data):
    out = []
    groups = sorted(set(d["group"] for d in data.values()),
                     key=lambda g: int(g.split("_")[1]))

    for g in groups:
        out.append(f":FonteDeCaptura_{g} a :FonteDeCaptura ;")
        out.append(f'    rdfs:comment "Câmera/canal DVR — grupo {g}"@pt .\n')

    for name, d in data.items():
        norm_conf = round(d["probe_score"] / 100.0, 2) if d["probe_score"] is not None else None
        out.append(f":{name} a :EvidenciaAudiovisual ;")
        out.append(f'    rdfs:comment "arquivo {name}, formato reportado {d["format_name"]}"@pt .\n')
        out.append(f":{name}_evento a :EventoDeCaptura .")
        out.append(f":{name} :temFonte :{name}_evento .")
        out.append(f":{name}_evento :temDispositivoEnvolvido :FonteDeCaptura_{d['group']} .\n")

        out.append(f":{name}_container a :MetadadoTecnico ;")
        out.append(f'    :temGrauDeConfianca "{norm_conf:.2f}"^^xsd:decimal ;')
        out.append(f'    rdfs:comment "container_reported={d["format_name"]}, '
                    f'probe_score={d["probe_score"]}/100 (normalizado {norm_conf:.2f})"@pt .')
        out.append(f":{name} :temMetadado :{name}_container .\n")

        if d["r_frame_rate"] and d["avg_frame_rate"]:
            out.append(f":{name}_rfr a :MetadadoTecnico ;")
            out.append(f'    rdfs:comment "r_frame_rate={d["r_frame_rate"]}"@pt .')
            out.append(f":{name}_avgfr a :MetadadoTecnico ;")
            out.append(f'    rdfs:comment "avg_frame_rate={d["avg_frame_rate"]}"@pt .')
            out.append(f":{name} :temMetadado :{name}_rfr, :{name}_avgfr .")
            rv, av = parse_rate(d["r_frame_rate"]), parse_rate(d["avg_frame_rate"])
            if rv is not None and av is not None and abs(rv - av) < 1e-6:
                out.append(f":{name}_rfr :correlacionaComEquivalencia :{name}_avgfr .\n")
            else:
                out.append(f":{name}_rfr :correlacionaComDivergencia :{name}_avgfr .\n")

    # Comparações de contêiner entre segmentos do mesmo grupo (câmera)
    for g in groups:
        members = [n for n, d in data.items() if d["group"] == g]
        by_format = {}
        for n in members:
            by_format.setdefault(data[n]["format_name"], []).append(n)
        formats = list(by_format.keys())
        if len(formats) > 1:
            out.append(f"\n# --- Divergência de contêiner dentro do grupo {g} ---")
            for fa, fb in combinations(formats, 2):
                for a in by_format[fa]:
                    for b in by_format[fb]:
                        out.append(f":{a}_container :correlacionaComDivergencia :{b}_container .")
        for fmt_name, members_same in by_format.items():
            if len(members_same) > 1:
                out.append(f"\n# --- Equivalência de contêiner dentro do grupo {g} (formato {fmt_name}) ---")
                for a, b in combinations(members_same, 2):
                    out.append(f":{a}_container :correlacionaComEquivalencia :{b}_container .")

    return "\n".join(out)


if __name__ == "__main__":
    paths = sys.argv[1:]
    if not paths:
        print(__doc__)
        sys.exit(1)
    corpus = load_corpus(paths)
    print(emit(corpus))
