<?xml version="1.0"?>
<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
         xmlns:owl="http://www.w3.org/2002/07/owl#"
         xml:base="http://example.org/pericia-audiovisual"
         xmlns="http://example.org/pericia-audiovisual#"
         xmlns:prov="http://www.w3.org/ns/prov#">

<owl:Ontology rdf:about="http://example.org/pericia-audiovisual">
  <owl:imports rdf:resource="http://www.w3.org/ns/prov-o"/>
  <rdfs:label xml:lang="pt">Esquema conceitual — metadados de proveniência audiovisual</rdfs:label>
  <rdfs:comment xml:lang="pt">Ontologia experimental implementada em OWL 2 DL; consistência e classificações confirmadas por execução real de HermiT e Pellet. Ver Seção 6.4 do artigo para limitações.</rdfs:comment>
</owl:Ontology>

<owl:ObjectProperty rdf:about="#temFonte">
  <rdfs:domain rdf:resource="#EvidenciaAudiovisual"/>
  <rdfs:range rdf:resource="#EventoDeCaptura"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Relaciona a evidência ao evento de captura técnica que a gerou; corresponde a prov:wasGeneratedBy.</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#temMetadado">
  <rdfs:domain rdf:resource="#EvidenciaAudiovisual"/>
  <rdfs:range rdf:resource="#MetadadoTecnico"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#correlacionaComEquivalencia">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
  <rdfs:subPropertyOf rdf:resource="#correlacionaCom"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#temInvalidacao">
  <rdfs:subPropertyOf rdf:resource="http://www.w3.org/ns/prov#wasInvalidatedBy"/>
  <rdfs:domain rdf:resource="#EvidenciaAudiovisual"/>
  <rdfs:range rdf:resource="#EventoDeInvalidacao"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#temDispositivoUtilizado">
  <rdfs:domain rdf:resource="#EventoDeCaptura"/>
  <rdfs:range rdf:resource="#FonteDeCaptura"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Relaciona o evento de captura ao dispositivo/sistema tecnicamente utilizado nessa atividade; corresponde a prov:used.</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#correlacionaComDivergencia">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
  <rdfs:subPropertyOf rdf:resource="#correlacionaCom"/>
  <rdfs:comment xml:lang="pt">Asserida por procedimento de pré-processamento externo à ontologia (pipeline de extração), não inferida (Seção 6.2).</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#correlacionaCom">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
  <rdfs:domain rdf:resource="#MetadadoTecnico"/>
  <rdfs:range rdf:resource="#MetadadoTecnico"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#temGeracao">
  <rdfs:subPropertyOf rdf:resource="http://www.w3.org/ns/prov#wasGeneratedBy"/>
  <rdfs:domain rdf:resource="#EvidenciaAudiovisual"/>
  <rdfs:range rdf:resource="#EventoDeGeracao"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#temOperador">
  <rdfs:domain rdf:resource="#FonteDeCaptura"/>
  <rdfs:range rdf:resource="#OperadorResponsavel"/>
</owl:ObjectProperty>

<owl:DatatypeProperty rdf:about="#temGrauDeConfianca">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#MetadadoTecnico"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  <rdfs:comment xml:lang="pt">Imagem em xsd:decimal no intervalo [0,0; 1,0].</rdfs:comment>
</owl:DatatypeProperty>

<owl:Class rdf:about="#EvidenciaAudiovisual">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Entity"/>
  <rdfs:label xml:lang="pt">Evidência Audiovisual</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#MetadadoTecnico">
  <rdfs:label xml:lang="pt">Metadado Técnico</rdfs:label>
  <rdfs:comment xml:lang="pt">Atributo técnico extraído de uma evidência, tratado por reificação como indivíduo dotado de identidade própria.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#FonteDeCaptura">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Entity"/>
  <rdfs:label xml:lang="pt">Fonte de Captura</rdfs:label>
  <rdfs:comment xml:lang="pt">Dispositivo ou sistema tecnicamente responsável pela geração original. Modelado como prov:Entity, não como agente (Seção 6.3).</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#EventoDeInvalidacao">
  <rdfs:subClassOf rdf:resource="#EventoDeCustodia"/>
  <rdfs:label xml:lang="pt">Evento de Invalidação</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#EventoDeCaptura">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Activity"/>
  <rdfs:label xml:lang="pt">Evento de Captura</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#EventoDeCustodia">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Activity"/>
  <rdfs:label xml:lang="pt">Evento de Custódia</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#MetadadoComProbeScoreBaixo">
  <rdfs:subClassOf rdf:resource="#MetadadoTecnico"/>
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#MetadadoTecnico"/>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#temGrauDeConfianca"/>
          <owl:someValuesFrom>
            <rdfs:Datatype>
              <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
              <owl:withRestrictions>
                <rdf:Description>
                  <rdf:first>
                    <rdf:Description>
                      <xsd:maxExclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.5</xsd:maxExclusive>
                    </rdf:Description>
                  </rdf:first>
                  <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                </rdf:Description>
              </owl:withRestrictions>
            </rdfs:Datatype>
          </owl:someValuesFrom>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
  <rdfs:label xml:lang="pt">Metadado com Probe Score Baixo</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#EventoDeGeracao">
  <rdfs:subClassOf rdf:resource="#EventoDeCustodia"/>
  <rdfs:label xml:lang="pt">Evento de Geração</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#OperadorResponsavel">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Agent"/>
  <rdfs:label xml:lang="pt">Operador Responsável</rdfs:label>
  <rdfs:comment xml:lang="pt">Pessoa física ou organização responsável pela operação de uma FonteDeCaptura.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#MetadadoDivergente">
  <rdfs:subClassOf rdf:resource="#MetadadoTecnico"/>
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#MetadadoTecnico"/>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#correlacionaComDivergencia"/>
          <owl:someValuesFrom rdf:resource="#MetadadoTecnico"/>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
  <rdfs:label xml:lang="pt">Metadado Divergente</rdfs:label>
</owl:Class>

<EvidenciaAudiovisual rdf:about="#Camera_7_3">
  <temFonte rdf:resource="#Camera_7_3_evento"/>
  <temMetadado rdf:resource="#Camera_7_3_container"/>
  <temMetadado rdf:resource="#Camera_7_3_rfr"/>
