#################################################################
# Comparações cruzadas de identificação de contêiner entre
# segmentos da MESMA câmera (Seção 5.1) — evidência direta do
# padrão de heterogeneidade descrito no artigo: segmentos da
# câmera 9 ora identificados como fluxo bruto ('hevc'), ora como
# contêiner proprietário ('dhav'), com scores de confiança muito
# distintos entre si.
#################################################################

# Subgrupo 'hevc' (fluxo bruto, probe_score=51/100): ['Camera_9_1', 'Camera_9_6', 'Camera_9_7']
